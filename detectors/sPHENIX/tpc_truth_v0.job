run_dir = /sphenix/user/dcxchenxi/develope/macros/detectors/sPHENIX
log_dir = $(run_dir)/log

Universe = vanilla
Executable = $(run_dir)/run_tpc_truth_v0.sh

# submit_tpc_truth_v0_campaign.sh overrides these with condor_submit -append.
campaign = tpc_truth_v0_test
input_dst_filelist = /sphenix/user/dcxchenxi/develope/macros/detectors/sPHENIX/output/pp_minbias_truthdst_100k_zero_vtx/dst_files.list
files_per_job = 100
events_per_input_file = 10
total_files = 10000
n_jobs = 100
output_base_dir = /sphenix/user/dcxchenxi/develope/macros/detectors/sPHENIX/output
input_path_base = /sphenix/user/dcxchenxi/develope/macros/detectors/sPHENIX
fit_method = helix
point_order = path
kalman_sigma_rphi_cm = 0.03
kalman_sigma_r_cm = 0.03
kalman_sigma_z_cm = 0.05
write_kalman_innovation_diagnostics = false
kalman_uniform_propagator = analytic
bfield_t = 1.4
coarse_steps = 64
pca_candidates = 32

Arguments = $(Process) $(files_per_job) $(events_per_input_file) $(total_files)

Output = $(log_dir)/$(campaign)/v0_$(Process).out
Error  = $(log_dir)/$(campaign)/v0_$(Process).err
Log    = $(log_dir)/tmp/$(campaign)/v0_$(Process).log

Initialdir = $(run_dir)

environment = "CAMPAIGN_TAG=$(campaign) OUTPUT_BASE_DIR=$(output_base_dir) COMPLETED_OUTPUT_DIR=$(output_base_dir)/$(campaign)/completed INPUT_DST_FILELIST=$(input_dst_filelist) INPUT_DST_PATH_BASE=$(input_path_base) V0_FIT_METHOD=$(fit_method) V0_POINT_ORDER=$(point_order) V0_KALMAN_SIGMA_RPHI_CM=$(kalman_sigma_rphi_cm) V0_KALMAN_SIGMA_R_CM=$(kalman_sigma_r_cm) V0_KALMAN_SIGMA_Z_CM=$(kalman_sigma_z_cm) V0_WRITE_KALMAN_INNOVATION_DIAGNOSTICS=$(write_kalman_innovation_diagnostics) V0_KALMAN_UNIFORM_PROPAGATOR=$(kalman_uniform_propagator) V0_BFIELD_T=$(bfield_t) V0_COARSE_STEPS=$(coarse_steps) V0_PCA_CANDIDATES=$(pca_candidates)"

RequestMemory = 4000
RequestDisk   = 200000

PeriodicHold = (NumJobStarts>=2 && JobStatus == 1)

Queue $(n_jobs)
