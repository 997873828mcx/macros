run_dir = /sphenix/user/dcxchenxi/develope/macros/detectors/sPHENIX
log_dir = $(run_dir)/log

Universe = vanilla
Executable = $(run_dir)/run_tpc_pattern_trackpoints.sh

# submit_tpc_pattern_trackpoints_campaign.sh overrides these with condor_submit -append.
campaign = tpc_pattern_trackpoints_test
input_dst_filelist = /sphenix/user/dcxchenxi/develope/TPC_pattern_reco_Analyse/macro/good_dst_files.list
files_per_job = 1
events_per_input_file = 500
total_files = 183
n_jobs = 183
output_base_dir = /sphenix/user/dcxchenxi/develope/macros/detectors/sPHENIX/output
input_path_base = /sphenix/user/dcxchenxi/develope/macros/detectors/sPHENIX

Arguments = $(Process) $(files_per_job) $(events_per_input_file) $(total_files)

Output = $(log_dir)/$(campaign)/trackpoints_$(Process).out
Error  = $(log_dir)/$(campaign)/trackpoints_$(Process).err
Log    = $(log_dir)/tmp/$(campaign)/trackpoints_$(Process).log

Initialdir = $(run_dir)

environment = "CAMPAIGN_TAG=$(campaign) OUTPUT_BASE_DIR=$(output_base_dir) COMPLETED_OUTPUT_DIR=$(output_base_dir)/$(campaign)/completed INPUT_DST_FILELIST=$(input_dst_filelist) INPUT_DST_PATH_BASE=$(input_path_base)"

RequestMemory = 4000
RequestDisk   = 2000000

PeriodicHold = (NumJobStarts>=2 && JobStatus == 1)

Queue $(n_jobs)
